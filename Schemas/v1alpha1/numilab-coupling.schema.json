{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://numivivo.org/schemas/v1alpha1/numilab-coupling.schema.json",
  "title": "NumiVivo NumiLab Coupling Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "channels"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "channels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 65536,
      "items": { "$ref": "#/$defs/channel" }
    },
    "metadata": {
      "type": "object",
      "maxProperties": 4096,
      "additionalProperties": { "type": "string", "maxLength": 4096 }
    }
  },
  "$defs": {
    "participant": {
      "enum": ["numanx", "numitissue", "numibrain", "numivivo", "environment", "experiment"]
    },
    "semantics": {
      "enum": ["replace", "add", "minimum", "maximum", "rate", "impulse", "event"]
    },
    "channel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "producer", "consumer", "unit", "semantics", "shape", "required", "schemaVersion"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "producer": { "$ref": "#/$defs/participant" },
        "consumer": { "$ref": "#/$defs/participant" },
        "unit": { "type": "string", "minLength": 1, "maxLength": 128 },
        "semantics": { "$ref": "#/$defs/semantics" },
        "shape": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "type": "integer", "minimum": 1, "maximum": 4294967295 }
        },
        "lowerBound": { "type": ["number", "null"] },
        "upperBound": { "type": ["number", "null"] },
        "required": { "type": "boolean" },
        "schemaVersion": { "type": "integer", "minimum": 1, "maximum": 4294967295 }
      },
      "allOf": [
        {
          "not": {
            "properties": {
              "producer": { "const": "numivivo" },
              "consumer": { "const": "numivivo" }
            },
            "required": ["producer", "consumer"]
          }
        },
        {
          "not": {
            "properties": {
              "producer": { "const": "numanx" },
              "consumer": { "const": "numanx" }
            },
            "required": ["producer", "consumer"]
          }
        },
        {
          "not": {
            "properties": {
              "producer": { "const": "numitissue" },
              "consumer": { "const": "numitissue" }
            },
            "required": ["producer", "consumer"]
          }
        },
        {
          "not": {
            "properties": {
              "producer": { "const": "numibrain" },
              "consumer": { "const": "numibrain" }
            },
            "required": ["producer", "consumer"]
          }
        }
      ]
    }
  }
}
