{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://numivivo.org/schemas/v1alpha1/surrogate-contract.schema.json",
  "title": "NumiVivo Surrogate Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "modelFingerprint",
    "trainingDataFingerprint",
    "mechanismPackFingerprint",
    "inputs",
    "outputs",
    "uncertaintyKind",
    "maximumNormalizedUncertainty",
    "maximumNormalizedExtrapolation",
    "maximumConsecutiveAcceptedSteps",
    "mandatoryAuthorityInterval"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "modelFingerprint": { "$ref": "#/$defs/fingerprint" },
    "trainingDataFingerprint": { "$ref": "#/$defs/fingerprint" },
    "mechanismPackFingerprint": { "$ref": "#/$defs/fingerprint" },
    "hostContextFingerprint": {
      "oneOf": [{ "$ref": "#/$defs/fingerprint" }, { "type": "null" }]
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 65536,
      "items": { "$ref": "#/$defs/feature" }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 65536,
      "items": { "$ref": "#/$defs/feature" }
    },
    "uncertaintyKind": {
      "enum": ["none", "predictedStandardDeviation", "ensembleVariance", "conformalRadius"]
    },
    "maximumNormalizedUncertainty": { "type": "number", "minimum": 0 },
    "maximumNormalizedExtrapolation": { "type": "number", "minimum": 0 },
    "maximumConsecutiveAcceptedSteps": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
    "mandatoryAuthorityInterval": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
    "fingerprint": { "$ref": "#/$defs/fingerprint" }
  },
  "$defs": {
    "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "unit", "minimum", "maximum", "normalizationOffset", "normalizationScale"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "unit": { "type": "string", "minLength": 1, "maxLength": 128 },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "normalizationOffset": { "type": "number" },
        "normalizationScale": { "type": "number", "not": { "const": 0 } }
      }
    }
  }
}
