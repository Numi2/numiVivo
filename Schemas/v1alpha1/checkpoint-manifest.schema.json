{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://numivivo.org/schemas/v1alpha1/checkpoint-manifest.schema.json",
  "title": "NumiVivo Checkpoint Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runtime",
    "artifactFingerprint",
    "stepIndex",
    "logicalTime",
    "randomStreamVersion",
    "sections",
    "metadata"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runtime": {
      "enum": ["programRuntime", "exactSSA", "population", "physiologicalFlow", "physiologicalPartition", "coupledNumiLab"]
    },
    "artifactFingerprint": { "$ref": "#/$defs/fingerprint" },
    "sourceFingerprint": { "oneOf": [{ "$ref": "#/$defs/fingerprint" }, { "type": "null" }] },
    "hostContextFingerprint": { "oneOf": [{ "$ref": "#/$defs/fingerprint" }, { "type": "null" }] },
    "experimentFingerprint": { "oneOf": [{ "$ref": "#/$defs/fingerprint" }, { "type": "null" }] },
    "couplingFingerprint": { "oneOf": [{ "$ref": "#/$defs/fingerprint" }, { "type": "null" }] },
    "parentCheckpointFingerprint": { "oneOf": [{ "$ref": "#/$defs/fingerprint" }, { "type": "null" }] },
    "stepIndex": { "type": "integer", "minimum": 0 },
    "logicalTime": { "type": "number", "minimum": 0 },
    "randomStreamVersion": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
    "sections": {
      "type": "array",
      "maxItems": 4096,
      "items": { "$ref": "#/$defs/section" }
    },
    "metadata": {
      "type": "object",
      "maxProperties": 4096,
      "additionalProperties": { "type": "string", "maxLength": 4096 }
    },
    "signingKeyID": { "type": ["string", "null"], "maxLength": 256 }
  },
  "$defs": {
    "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "encoding", "offset", "length", "elementCount", "elementStride", "fingerprint"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "encoding": { "enum": ["rawBytes", "float32LittleEndian", "uint32LittleEndian", "canonicalJSON"] },
        "offset": { "type": "integer", "minimum": 0 },
        "length": { "type": "integer", "minimum": 0 },
        "elementCount": { "type": "integer", "minimum": 0 },
        "elementStride": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "fingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    }
  }
}
