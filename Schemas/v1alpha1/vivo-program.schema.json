{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://numivivo.org/schemas/v1alpha1/vivo-program.schema.json",
  "title": "NumiVivo VivoProgram",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "numivivo.org/v1alpha1" },
    "kind": { "const": "VivoProgram" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "spec": { "$ref": "#/$defs/spec" }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
    },
    "finiteNumber": { "type": "number" },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min": { "$ref": "#/$defs/finiteNumber" },
        "max": { "$ref": "#/$defs/finiteNumber" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "class": {
          "enum": ["observed", "derived", "calibrated", "inferred", "assumed", "hypothetical"]
        },
        "source": { "type": "string", "maxLength": 4096 },
        "dataset": { "type": "string", "maxLength": 1024 },
        "context": { "type": "string", "maxLength": 4096 },
        "note": { "type": "string", "maxLength": 4096 }
      }
    },
    "quantity": {
      "oneOf": [
        { "$ref": "#/$defs/finiteNumber" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "unit"],
          "properties": {
            "value": { "$ref": "#/$defs/finiteNumber" },
            "unit": { "type": "string", "minLength": 1, "maxLength": 128 }
          }
        }
      ]
    },
    "duration": {
      "oneOf": [
        { "type": "number", "minimum": 0 },
        {
          "type": "string",
          "pattern": "^[+]?(?:[0-9]+(?:\\.[0-9]+)?|\\.[0-9]+)[ ]*(?:us|µs|ms|s|min|h|hour|d|day)$"
        }
      ]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "description": { "type": "string", "maxLength": 16384 },
        "namespace": { "type": "string", "maxLength": 2048 },
        "labels": {
          "type": "object",
          "maxProperties": 256,
          "additionalProperties": { "type": "string", "maxLength": 1024 }
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cellType"],
      "properties": {
        "cellType": { "type": "string", "minLength": 1, "maxLength": 512 },
        "tissue": { "type": "string", "maxLength": 512 },
        "species": { "type": "string", "maxLength": 512 },
        "developmentalStage": { "type": "string", "maxLength": 512 },
        "diseaseState": { "type": "string", "maxLength": 1024 },
        "deliveryMode": { "type": "string", "maxLength": 512 }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "source": {
          "enum": ["intracellular", "extracellular", "membrane", "host", "numanx", "numitissue", "numibrain", "experiment"]
        },
        "unit": { "type": "string", "minLength": 1, "maxLength": 128 },
        "default": { "$ref": "#/$defs/finiteNumber" },
        "bounds": { "$ref": "#/$defs/bounds" },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "species": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "kind": { "enum": ["count", "concentration", "activity", "occupancy", "output", "external-field", "latent"] },
        "compartment": { "type": "string", "minLength": 1, "maxLength": 256 },
        "unit": { "type": "string", "minLength": 1, "maxLength": 128 },
        "initial": { "$ref": "#/$defs/quantity" },
        "bounds": { "$ref": "#/$defs/bounds" },
        "conserved": { "type": "boolean" },
        "externallyOwned": { "type": "boolean" },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "enum": ["scalar", "leaky-integrator", "latch", "counter", "timer", "finite-state", "permanent-memory"] },
        "unit": { "type": "string", "minLength": 1, "maxLength": 128 },
        "initial": { "$ref": "#/$defs/quantity" },
        "halfLife": { "$ref": "#/$defs/duration" },
        "bounds": { "$ref": "#/$defs/bounds" },
        "states": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "leaky-integrator" } } },
          "then": { "required": ["halfLife"] }
        },
        {
          "if": { "properties": { "type": { "const": "finite-state" } } },
          "then": { "required": ["states"] }
        }
      ]
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "value"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "unit": { "type": "string", "minLength": 1, "maxLength": 128 },
        "value": { "$ref": "#/$defs/quantity" },
        "bounds": { "$ref": "#/$defs/bounds" },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "stoichiometry": {
      "oneOf": [
        { "$ref": "#/$defs/identifier" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["species"],
          "properties": {
            "species": { "$ref": "#/$defs/identifier" },
            "coefficient": { "type": "integer", "minimum": 1, "maximum": 32767 }
          }
        }
      ]
    },
    "reference": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["signal"],
          "properties": { "signal": { "$ref": "#/$defs/identifier" }, "unit": { "type": "string" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["input"],
          "properties": { "input": { "$ref": "#/$defs/identifier" }, "unit": { "type": "string" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["species"],
          "properties": { "species": { "$ref": "#/$defs/identifier" }, "unit": { "type": "string" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state"],
          "properties": { "state": { "$ref": "#/$defs/identifier" }, "unit": { "type": "string" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["parameter"],
          "properties": { "parameter": { "$ref": "#/$defs/identifier" }, "unit": { "type": "string" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["host"],
          "properties": { "host": { "$ref": "#/$defs/identifier" }, "unit": { "type": "string" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["time"],
          "properties": { "time": { "const": true } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["ref"],
          "properties": {
            "ref": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id"],
              "properties": {
                "id": { "$ref": "#/$defs/identifier" },
                "kind": { "enum": ["input", "signal", "species", "state", "parameter", "host"] },
                "unit": { "type": "string" }
              }
            }
          }
        }
      ]
    },
    "expression": {
      "oneOf": [
        { "type": "boolean" },
        { "$ref": "#/$defs/finiteNumber" },
        { "$ref": "#/$defs/reference" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["literal"],
          "properties": { "literal": { "$ref": "#/$defs/quantity" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["not"],
          "properties": { "not": { "$ref": "#/$defs/expression" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["all"],
          "properties": {
            "all": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "$ref": "#/$defs/expression" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["any"],
          "properties": {
            "any": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "$ref": "#/$defs/expression" } }
          }
        },
        { "$ref": "#/$defs/binaryExpression" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["clamp"],
          "properties": {
            "clamp": {
              "type": "object",
              "additionalProperties": false,
              "required": ["value", "min", "max"],
              "properties": {
                "value": { "$ref": "#/$defs/expression" },
                "min": { "$ref": "#/$defs/expression" },
                "max": { "$ref": "#/$defs/expression" }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["sustained"],
          "properties": {
            "sustained": {
              "type": "object",
              "additionalProperties": false,
              "required": ["condition", "for"],
              "properties": {
                "condition": { "$ref": "#/$defs/expression" },
                "for": { "$ref": "#/$defs/duration" }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["within"],
          "properties": {
            "within": {
              "type": "object",
              "additionalProperties": false,
              "required": ["condition", "window"],
              "properties": {
                "condition": { "$ref": "#/$defs/expression" },
                "window": { "$ref": "#/$defs/duration" }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["risingEdge"],
          "properties": { "risingEdge": { "$ref": "#/$defs/expression" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["fallingEdge"],
          "properties": { "fallingEdge": { "$ref": "#/$defs/expression" } }
        }
      ]
    },
    "binaryOperands": {
      "oneOf": [
        {
          "type": "array",
          "prefixItems": [{ "$ref": "#/$defs/expression" }, { "$ref": "#/$defs/expression" }],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["left", "right"],
          "properties": {
            "left": { "$ref": "#/$defs/expression" },
            "right": { "$ref": "#/$defs/expression" }
          }
        }
      ]
    },
    "binaryExpression": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["gt"], "properties": { "gt": { "$ref": "#/$defs/binaryOperands" } } },
        { "type": "object", "additionalProperties": false, "required": ["gte"], "properties": { "gte": { "$ref": "#/$defs/binaryOperands" } } },
        { "type": "object", "additionalProperties": false, "required": ["lt"], "properties": { "lt": { "$ref": "#/$defs/binaryOperands" } } },
        { "type": "object", "additionalProperties": false, "required": ["lte"], "properties": { "lte": { "$ref": "#/$defs/binaryOperands" } } },
        { "type": "object", "additionalProperties": false, "required": ["eq"], "properties": { "eq": { "$ref": "#/$defs/binaryOperands" } } },
        { "type": "object", "additionalProperties": false, "required": ["neq"], "properties": { "neq": { "$ref": "#/$defs/binaryOperands" } } },
        { "type": "object", "additionalProperties": false, "required": ["add"], "properties": { "add": { "$ref": "#/$defs/binaryOperands" } } },
        { "type": "object", "additionalProperties": false, "required": ["subtract"], "properties": { "subtract": { "$ref": "#/$defs/binaryOperands" } } },
        { "type": "object", "additionalProperties": false, "required": ["multiply"], "properties": { "multiply": { "$ref": "#/$defs/binaryOperands" } } },
        { "type": "object", "additionalProperties": false, "required": ["divide"], "properties": { "divide": { "$ref": "#/$defs/binaryOperands" } } },
        { "type": "object", "additionalProperties": false, "required": ["min"], "properties": { "min": { "$ref": "#/$defs/binaryOperands" } } },
        { "type": "object", "additionalProperties": false, "required": ["max"], "properties": { "max": { "$ref": "#/$defs/binaryOperands" } } }
      ]
    },
    "rate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["law"],
      "properties": {
        "law": { "enum": ["zero-order", "mass-action", "hill-activation", "hill-repression", "michaelis-menten", "reversible-mass-action", "passive-transport", "saturable-transport", "degradation", "custom"] },
        "parameters": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "expression": { "$ref": "#/$defs/expression" }
      }
    },
    "reaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "rate"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "compartment": { "type": "string", "minLength": 1, "maxLength": 256 },
        "reactants": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/stoichiometry" } },
        "products": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/stoichiometry" } },
        "rate": { "$ref": "#/$defs/rate" },
        "gate": { "$ref": "#/$defs/expression" },
        "delay": { "$ref": "#/$defs/duration" },
        "critical": { "type": "boolean" }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["set-output", "add-output", "express", "suppress", "degrade", "set-state", "increment-state", "emit-event", "request-differentiation", "request-migration", "reversible-shutdown", "permanent-shutdown"] },
        "target": { "type": "string", "maxLength": 256 },
        "value": { "$ref": "#/$defs/expression" },
        "constant": { "$ref": "#/$defs/finiteNumber" },
        "unit": { "type": "string", "maxLength": 128 },
        "maximumRate": { "type": "number", "minimum": 0 }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "when", "actions"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "when": { "$ref": "#/$defs/expression" },
        "actions": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "$ref": "#/$defs/action" } },
        "priority": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 },
        "refractory": { "$ref": "#/$defs/duration" }
      }
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "expression"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "expression": { "$ref": "#/$defs/expression" },
        "severity": { "enum": ["note", "warning", "error", "fatal"] },
        "response": { "enum": ["record", "clamp", "reject-step", "substep", "reversible-shutdown", "permanent-shutdown"] },
        "message": { "type": "string", "maxLength": 4096 }
      }
    },
    "termination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "when"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "when": { "$ref": "#/$defs/expression" },
        "action": { "enum": ["reversible-shutdown", "permanent-shutdown"] },
        "reason": { "type": "string", "maxLength": 4096 }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target"],
      "properties": {
        "target": { "$ref": "#/$defs/target" },
        "minimumFidelity": { "enum": ["F0", "F1", "F2", "F3", "F4"] },
        "inputs": { "type": "array", "maxItems": 16384, "items": { "$ref": "#/$defs/input" } },
        "species": { "type": "array", "maxItems": 16384, "items": { "$ref": "#/$defs/species" } },
        "state": { "type": "array", "maxItems": 16384, "items": { "$ref": "#/$defs/state" } },
        "parameters": { "type": "array", "maxItems": 65536, "items": { "$ref": "#/$defs/parameter" } },
        "reactions": { "type": "array", "maxItems": 65536, "items": { "$ref": "#/$defs/reaction" } },
        "rules": { "type": "array", "maxItems": 16384, "items": { "$ref": "#/$defs/rule" } },
        "constraints": { "type": "array", "maxItems": 16384, "items": { "$ref": "#/$defs/constraint" } },
        "termination": { "type": "array", "maxItems": 16384, "items": { "$ref": "#/$defs/termination" } }
      }
    }
  }
}
